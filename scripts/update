#!/usr/bin/env python3
"""STUDENT: get the latest version of the world.

    scripts/update

Claude runs this when you say "update". It pulls in everyone else's islands and
any fixes to the template.

It will refuse to run if you have work you haven't committed yet — say "share my
island" first, then "update". Your own island is never overwritten: this merges
the world's changes into what you already have, and if the two clash it stops
and changes nothing.

You will rarely need this. Sharing is the thing you do all class.
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent


def git(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=REPO_ROOT, capture_output=True, text=True)


def main() -> int:
    if not (REPO_ROOT / ".git").exists():
        raise SystemExit("✗ this folder isn't a git repo — ask your teacher for help.")

    # Don't strip() the whole blob: porcelain lines start with a two-column
    # status field that is often " M", and stripping eats it — which silently
    # chops the first character off the filename.
    dirty = [line for line in git("status", "--porcelain").stdout.splitlines() if line.strip()]
    if dirty:
        print("✋ You have changes that haven't been shared yet:\n")
        for line in dirty[:10]:
            print(f"    {line[2:].lstrip()}")
        print(
            "\n   Say 'share my island' first so your work is safe,\n"
            "   then say 'update' again."
        )
        return 1

    print("→ fetching the latest world…")
    fetch = git("fetch", "origin")
    if fetch.returncode != 0:
        print("😅 Couldn't reach the server. Check the wifi and try again.")
        print(fetch.stderr.strip()[:300])
        return 1

    # Merge, never reset. A reset would point this branch at main and throw away
    # everything the student has committed but not had merged in yet.
    before = git("rev-parse", "HEAD").stdout.strip()
    merge = git("merge", "--no-edit", "origin/main")
    if merge.returncode != 0:
        git("merge", "--abort")
        print("\n😅 The update clashed with your own work, so nothing changed —")
        print("   your island is exactly as you left it.")
        print("   Ask your teacher to sort it out.")
        print(merge.stdout.strip()[:300])
        return 1
    after = git("rev-parse", "HEAD").stdout.strip()

    if before == after:
        print("\n✅ Already up to date — you have the latest world.")
    else:
        count = git("rev-list", "--count", f"{before}..{after}").stdout.strip() or "some"
        print(f"\n✅ Updated! ({count} new change(s) from the rest of the class.)")
        print("   Run your game again to make sure it still works.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
