#!/usr/bin/env node
// Verifies the vertical slice that the whole class depends on:
//
//     island WASM boots in a sandboxed iframe  →  islands_sdk postMessage
//                                              →  the shell receives a score
//
// If this passes, a student's score really will reach the world scoreboard.
//
//     node scripts/check-bridge                      # checks the first island
//     node scripts/check-bridge --island demo-01
//     node scripts/check-bridge --url http://localhost:8787 --timeout 90
//
// Needs the dev server running (scripts/dev) and Google Chrome installed.

import { spawn } from "node:child_process";
import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

// Node 22+ ships a WebSocket client, so this script needs no dependencies.
if (typeof WebSocket === "undefined") {
  console.error("✗ this script needs Node 22 or newer (for the built-in WebSocket).");
  process.exit(1);
}

const REPO_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const SITE_DIR = join(REPO_ROOT, "site");

const CHROME_CANDIDATES = [
  process.env.CHROME_PATH,
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
  "/Applications/Chromium.app/Contents/MacOS/Chromium",
  "/usr/bin/google-chrome",
  "/usr/bin/chromium",
  "/usr/bin/chromium-browser",
  "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
].filter(Boolean);

// ── args ───────────────────────────────────────────────────────────────────

const args = process.argv.slice(2);
const flag = (name, fallback) => {
  const index = args.indexOf(`--${name}`);
  return index >= 0 && args[index + 1] ? args[index + 1] : fallback;
};

// 127.0.0.1, not localhost — pygbag's runtime treats the hostname "localhost"
// as "I am behind pygbag's own dev proxy" and rewrites its CDN to a port-8000
// server that doesn't exist, so islands hang forever on the loading screen.
const BASE_URL = flag("url", "http://127.0.0.1:8787").replace(/\/$/, "");
const TIMEOUT_S = Number(flag("timeout", "90"));
const PORT = Number(flag("debug-port", "9222"));

function pickIsland() {
  const explicit = flag("island", null);
  if (explicit) return explicit;
  const registryPath = join(SITE_DIR, "registry.json");
  if (!existsSync(registryPath)) {
    throw new Error("no site/registry.json — run scripts/build-islands first");
  }
  const registry = JSON.parse(readFileSync(registryPath, "utf8"));
  if (!registry.length) throw new Error("registry is empty — add an island first");
  return registry[0].id;
}

// ── the harness page ───────────────────────────────────────────────────────
// Served from the site directory so the iframe is same-origin, exactly like
// the real shell. Cleaned up afterwards.

const HARNESS_NAME = "__bridge-check.html";

function harnessHtml(islandId, sandbox) {
  return `<!doctype html>
<meta charset="utf-8">
<title>bridge check</title>
<body style="margin:0;background:#000">
<iframe id="f" sandbox="${sandbox}"
        src="./islands/${islandId}/index.html"
        style="width:900px;height:700px;border:0"></iframe>
<script>
window.__bridge = { messages: [], errors: [], booted: false };
window.addEventListener("message", (e) => {
  if (e.source !== document.getElementById("f").contentWindow) return;
  const d = e.data;
  if (d && typeof d === "object" && typeof d.type === "string") {
    window.__bridge.booted = true;
    window.__bridge.messages.push({ type: d.type, value: d.value });
  }
});
window.addEventListener("error", (e) => window.__bridge.errors.push(String(e.message)));
</script>
</body>`;
}

// ── minimal Chrome DevTools Protocol client ────────────────────────────────

class Cdp {
  constructor(socket) {
    this.socket = socket;
    this.nextId = 1;
    this.pending = new Map();
    socket.addEventListener("message", (event) => {
      let message;
      try {
        message = JSON.parse(String(event.data));
      } catch {
        return;
      }
      const resolver = this.pending.get(message.id);
      if (resolver) {
        this.pending.delete(message.id);
        resolver(message);
      }
    });
  }

  send(method, params = {}) {
    const id = this.nextId++;
    return new Promise((resolve, reject) => {
      this.pending.set(id, resolve);
      this.socket.send(JSON.stringify({ id, method, params }));
      setTimeout(() => {
        if (this.pending.delete(id)) reject(new Error(`${method} timed out`));
      }, 30000);
    });
  }

  async evaluate(expression) {
    const response = await this.send("Runtime.evaluate", {
      expression,
      returnByValue: true,
      awaitPromise: true,
    });
    if (response.error) throw new Error(response.error.message);
    return response.result?.result?.value;
  }
}

const wait = (ms) => new Promise((r) => setTimeout(r, ms));

// Chrome's /json/new wants PUT on recent versions and GET on older ones, and
// the whole endpoint is unreachable until the browser has finished starting.
async function fetchJson(url, attempts = 40) {
  for (let i = 0; i < attempts; i++) {
    for (const method of ["PUT", "GET"]) {
      try {
        const response = await fetch(url, { method });
        if (response.ok) return await response.json();
      } catch {
        /* chrome isn't up yet */
      }
    }
    await wait(250);
  }
  throw new Error(`could not reach ${url}`);
}

// ── main ───────────────────────────────────────────────────────────────────

async function main() {
  const chrome = CHROME_CANDIDATES.find((path) => existsSync(path));
  if (!chrome) {
    console.error("✗ could not find Google Chrome. Set CHROME_PATH to its binary.");
    process.exit(1);
  }

  try {
    await fetch(`${BASE_URL}/registry.json`);
  } catch {
    console.error(`✗ no server at ${BASE_URL} — start it with: scripts/dev`);
    process.exit(1);
  }

  const islandId = pickIsland();
  const sandbox = args.includes("--strict-sandbox")
    ? "allow-scripts"
    : "allow-scripts allow-same-origin";

  console.log(`checking the score bridge for '${islandId}'`);
  console.log(`  sandbox: ${sandbox}`);
  console.log(`  this downloads the Python runtime — it can take a minute…\n`);

  const harnessPath = join(SITE_DIR, HARNESS_NAME);
  writeFileSync(harnessPath, harnessHtml(islandId, sandbox), "utf8");

  const profile = mkdtempSync(join(tmpdir(), "islands-bridge-"));
  const browser = spawn(
    chrome,
    [
      "--headless=new",
      "--disable-gpu",
      "--no-first-run",
      "--no-default-browser-check",
      `--remote-debugging-port=${PORT}`,
      `--user-data-dir=${profile}`,
      "about:blank",
    ],
    { stdio: "ignore" }
  );

  let failed = false;

  try {
    await fetchJson(`http://127.0.0.1:${PORT}/json/version`);

    // Drive the browser's existing foreground tab rather than opening a new
    // one. A tab opened via /json/new is a BACKGROUND tab, and Chrome throttles
    // timers and stops rAF in hidden tabs — which stalls pygbag's boot forever
    // and makes a perfectly good island look broken.
    const targets = await fetchJson(`http://127.0.0.1:${PORT}/json/list`);
    const target = targets.find((t) => t.type === "page");
    if (!target) throw new Error("Chrome exposed no page to drive");

    const socket = new WebSocket(target.webSocketDebuggerUrl);
    await new Promise((resolve, reject) => {
      socket.addEventListener("open", resolve, { once: true });
      socket.addEventListener("error", () => reject(new Error("CDP socket failed")), {
        once: true,
      });
    });

    const cdp = new Cdp(socket);
    await cdp.send("Runtime.enable");
    await cdp.send("Page.enable");
    await cdp.send("Page.bringToFront");
    await cdp.send("Emulation.setFocusEmulationEnabled", { enabled: true });
    await cdp.send("Page.navigate", { url: `${BASE_URL}/${HARNESS_NAME}` });

    const deadline = Date.now() + TIMEOUT_S * 1000;
    let state = null;
    let dots = 0;

    const verbose = args.includes("--verbose");

    while (Date.now() < deadline) {
      await wait(1500);
      const raw = await cdp
        .evaluate("JSON.stringify(window.__bridge || null)")
        .catch((error) => (verbose ? console.log(`\n  eval failed: ${error.message}`) : null));
      state = raw ? JSON.parse(raw) : null;
      if (verbose) console.log(`\n  state: ${raw}`);
      if (state?.messages?.length) break;
      process.stdout.write(`\r  waiting for the island to boot${".".repeat((dots++ % 3) + 1)}   `);
    }
    process.stdout.write("\r" + " ".repeat(50) + "\r");

    const messages = state?.messages ?? [];
    const scoreMessages = messages.filter((m) => m.type === "score");

    if (scoreMessages.length) {
      console.log(`  ✓ island booted and postMessaged the shell`);
      console.log(`  ✓ received: ${JSON.stringify(messages.slice(0, 4))}`);
      console.log(`  ✓ islands_sdk → shell score bridge works`);
      console.log("\nbridge check passed ✅");
    } else {
      failed = true;
      console.log("  ✗ no score message arrived from the island");
      if (state?.errors?.length) {
        console.log(`  page errors: ${state.errors.slice(0, 5).join(" | ")}`);
      }
      console.log(
        "\nThings to check:\n" +
          "  · is the machine online? islands load their Python runtime from\n" +
          "    https://pygame-web.github.io/cdn/ at runtime\n" +
          "  · does the island run natively?  scripts/check-island " +
          islandId +
          "\n" +
          "  · try a longer timeout:  node scripts/check-bridge --timeout 180"
      );
      console.log("\nbridge check failed ❌");
    }

    socket.close();
  } finally {
    browser.kill();
    rmSync(harnessPath, { force: true });
    // Chrome may still be flushing its profile as it exits; a failed cleanup of
    // a temp dir must not fail the check.
    try {
      rmSync(profile, { recursive: true, force: true, maxRetries: 5, retryDelay: 200 });
    } catch {
      /* the OS will reap it */
    }
  }

  process.exit(failed ? 1 : 0);
}

main().catch((error) => {
  console.error("✗", error.message);
  process.exit(1);
});
