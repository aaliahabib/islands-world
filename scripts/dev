#!/usr/bin/env python3
"""TEACHER: run the whole world locally — build the site, then serve it.

    scripts/dev                 # build every island, then serve on :8787
    scripts/dev --fast          # skip the pygbag builds (shell + map only)
    scripts/dev --port 9000

Open http://localhost:8787 . The Node server serves the site AND the WebSocket
on the same port, so the shell finds it with no configuration.

Students never run this — they only ever run their own game in PyCharm.
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
SERVER_DIR = REPO_ROOT / "core" / "server"
SITE_DIR = REPO_ROOT / "site"


def main() -> int:
    parser = argparse.ArgumentParser(description="Build and serve Islands World locally.")
    parser.add_argument("--port", type=int, default=8787)
    parser.add_argument(
        "--fast",
        action="store_true",
        help="skip pygbag; assemble the shell and registry only",
    )
    parser.add_argument("--no-build", action="store_true", help="serve ./site as it is")
    args = parser.parse_args()

    if not args.no_build:
        command = [sys.executable, str(REPO_ROOT / "scripts" / "build-islands")]
        if args.fast:
            command.append("--skip-wasm")
        result = subprocess.run(command, cwd=REPO_ROOT)
        if result.returncode != 0:
            print("\n✗ build failed — not starting the server")
            return result.returncode

    if not (SITE_DIR / "index.html").is_file():
        print("✗ no site/ to serve — run scripts/build-islands first")
        return 1

    if shutil.which("node") is None:
        print("✗ node is not installed. Install Node 18+ to run the server.")
        return 1

    if not (SERVER_DIR / "node_modules").is_dir():
        print("→ installing server dependencies (one time)…")
        install = subprocess.run(["npm", "install"], cwd=SERVER_DIR)
        if install.returncode != 0:
            print("✗ npm install failed")
            return install.returncode

    env = {
        **os.environ,
        "PORT": str(args.port),
        "SITE_DIR": str(SITE_DIR),
    }
    print()
    print("─" * 58)
    print(f"  Islands World → http://127.0.0.1:{args.port}")
    print()
    print("  ⚠️  Use 127.0.0.1, NOT localhost.")
    print("     pygbag's runtime special-cases the hostname 'localhost' and")
    print("     redirects its CDN to a dev proxy on port 8000 that isn't there,")
    print("     so islands never finish loading. 127.0.0.1 avoids that.")
    print("     (Deployed sites have a real hostname, so this only bites locally.)")
    print()
    print("  Ctrl-C to stop")
    print("─" * 58)
    print()

    try:
        return subprocess.run(["node", "server.js"], cwd=SERVER_DIR, env=env).returncode
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
