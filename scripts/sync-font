#!/usr/bin/env python3
"""Regenerate core/shell/src/vecfont.js from islands/_template/vector_font.py.

The overworld and the island games share one stroke font. The Python file is the
source of truth; this copies the glyph table into JS so the two can never drift.
Run it if you ever edit GLYPHS in vector_font.py.
"""

from __future__ import annotations

import ast
import json
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
SOURCE = REPO_ROOT / "islands" / "_template" / "vector_font.py"
TARGET = REPO_ROOT / "core" / "shell" / "src" / "vecfont.js"

HEADER = """// GENERATED from islands/_template/vector_font.py — do not edit by hand.
// Regenerate with: scripts/sync-font
//
// The same stroke font the island games use, so the overworld and the games
// share one typeface. Glyphs are polylines on a 4x6 grid, y pointing down.

export const GLYPH_W = 4.0;
export const GLYPH_H = 6.0;
export const ADVANCE = 6.0;

export const GLYPHS = """

FOOTER = """
export function textWidth(text, size) {
  if (!text) return 0;
  const unit = size / GLYPH_H;
  return (text.length * ADVANCE - (ADVANCE - GLYPH_W)) * unit;
}

/**
 * Draw `text` as vector strokes on a 2D canvas context.
 * `x, y` is the top-left, or the top-centre when `center` is true.
 */
export function drawText(ctx, text, x, y, size = 24, opts = {}) {
  const { center = false, width = 2, color = "#000" } = opts;
  const chars = String(text).toUpperCase();
  const unit = size / GLYPH_H;
  let cx = center ? x - textWidth(chars, size) / 2 : x;

  ctx.save();
  ctx.strokeStyle = color;
  ctx.lineWidth = width;
  ctx.lineCap = "round";
  ctx.lineJoin = "round";
  ctx.beginPath();
  for (const ch of chars) {
    const strokes = GLYPHS[ch] ?? GLYPHS["?"];
    for (const stroke of strokes) {
      if (stroke.length < 2) continue;
      ctx.moveTo(cx + stroke[0][0] * unit, y + stroke[0][1] * unit);
      for (let i = 1; i < stroke.length; i++) {
        ctx.lineTo(cx + stroke[i][0] * unit, y + stroke[i][1] * unit);
      }
    }
    cx += ADVANCE * unit;
  }
  ctx.stroke();
  ctx.restore();
}
"""


def load_glyphs() -> dict:
    """Read GLYPHS out of the Python module without importing pygame."""
    tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
    namespace: dict = {}
    for node in tree.body:
        if isinstance(node, ast.Assign):
            name = getattr(node.targets[0], "id", None)
            if name and name.isupper() or name == "_DOT":
                try:
                    namespace[name] = ast.literal_eval(node.value)
                except ValueError:
                    pass
        elif isinstance(node, ast.AnnAssign):
            if getattr(node.target, "id", None) == "GLYPHS":
                code = compile(ast.Expression(node.value), "<glyphs>", "eval")
                namespace["GLYPHS"] = eval(code, {}, namespace)  # noqa: S307
    if "GLYPHS" not in namespace:
        raise SystemExit(f"could not find GLYPHS in {SOURCE}")
    return namespace["GLYPHS"]


def main() -> None:
    glyphs = load_glyphs()
    payload = json.dumps(glyphs, separators=(",", ":"))
    TARGET.parent.mkdir(parents=True, exist_ok=True)
    TARGET.write_text(HEADER + payload + ";\n" + FOOTER, encoding="utf-8")
    print(f"wrote {TARGET.relative_to(REPO_ROOT)} — {len(glyphs)} glyphs")


if __name__ == "__main__":
    main()
