#!/usr/bin/env python3
"""Smoke-test an island by actually running it, headless, for a couple of seconds.

    scripts/check-island <island-id>     # e.g. scripts/check-island alice
    scripts/check-island --all

This catches the failures that matter most in class: a syntax error, a bad
import, a crash on the first frame. CI runs it before the WASM build so a broken
island never reaches the world.

It runs the game with a dummy video driver and posts a QUIT event after a short
while, so a normal game exits cleanly. Any exception is a failure.
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
ISLANDS_DIR = REPO_ROOT / "islands"

# Run the island in a subprocess so a hard crash (or pygame calling sys.exit)
# can't take the checker down with it.
RUNNER = r"""
import os, sys, threading, runpy, time
os.environ.setdefault("SDL_VIDEODRIVER", "dummy")
os.environ.setdefault("SDL_AUDIODRIVER", "dummy")

island_dir = sys.argv[1]
repo_root = sys.argv[2]
seconds = float(sys.argv[3])

sys.path.insert(0, island_dir)
sys.path.insert(0, repo_root)
os.chdir(island_dir)

import pygame

def quit_soon():
    time.sleep(seconds)
    try:
        pygame.event.post(pygame.event.Event(pygame.QUIT))
    except Exception:
        os._exit(0)
    # If the game ignores QUIT, don't hang the build.
    time.sleep(3.0)
    os._exit(0)

threading.Thread(target=quit_soon, daemon=True).start()
runpy.run_path(os.path.join(island_dir, "main.py"), run_name="__main__")
"""


def check(island_id: str, seconds: float) -> bool:
    island_dir = ISLANDS_DIR / island_id
    main_py = island_dir / "main.py"

    if not main_py.is_file():
        print(f"  ✗ {island_id}: no main.py")
        return False

    source = main_py.read_text(encoding="utf-8", errors="replace")
    for required in ("async def main", "asyncio.run"):
        if required not in source:
            print(
                f"  ✗ {island_id}: main.py is missing `{required}` — the browser "
                f"build needs an async main loop started with asyncio.run(main())"
            )
            return False

    result = subprocess.run(
        [sys.executable, "-c", RUNNER, str(island_dir), str(REPO_ROOT), str(seconds)],
        capture_output=True,
        text=True,
        timeout=90,
    )
    if result.returncode != 0:
        print(f"  ✗ {island_id}: crashed while running")
        tail = (result.stderr or result.stdout).strip().splitlines()[-15:]
        for line in tail:
            print(f"      {line}")
        return False

    print(f"  ✓ {island_id}")
    return True


def main() -> int:
    parser = argparse.ArgumentParser(description="Smoke-test island games.")
    parser.add_argument("islands", nargs="*", help="island ids to check")
    parser.add_argument("--all", action="store_true", help="check every island")
    parser.add_argument(
        "--seconds", type=float, default=2.0, help="how long to run each island"
    )
    args = parser.parse_args()

    if args.all or not args.islands:
        targets = sorted(
            p.name for p in ISLANDS_DIR.iterdir() if (p / "main.py").is_file()
        )
    else:
        targets = args.islands

    if not targets:
        print("no islands to check")
        return 0

    print(f"checking {len(targets)} island(s)…")
    failures = [island for island in targets if not check(island, args.seconds)]

    if failures:
        print(f"\n{len(failures)} island(s) failed: {', '.join(failures)}")
        return 1
    print("\nall islands run ✅")
    return 0


if __name__ == "__main__":
    sys.exit(main())
